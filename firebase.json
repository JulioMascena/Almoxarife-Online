{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "firestore.rules",
      "**/.*",
      "**/.*/**",
      ".git/**",
      ".firebase/**",
      "**/node_modules/**",
      "tests/**",
      ".impeccable/**",
      ".agents/**",
      ".codex/**",
      ".idea/**",
      "*.md",
      "skills-lock.json",
      "README.md",
      "tavara-funcionalidades.md",
      "firebase-debug.log",
      "firestore-debug.log"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      }
    ]
  }
}
